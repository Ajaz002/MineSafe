# ==========================================
# MineSafe Project .gitignore
# ==========================================

# Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Dependencies
node_modules/
frontend/node_modules/
dist/
frontend/dist/

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
.eggs/

# Datasets & Multi-Gigabyte Training Artifacts
Datasets/
processed_dataset/
runs/
.backup/

# Base Pretrained Weights & Intermediate Checkpoints
# (The trained production best checkpoint `models/minesafe_yolo11s_best.pt` is 18.3 MB and tracked)
yolo11n.pt
yolo11s.pt
models/minesafe_yolo11s_last.pt
*.weights

# Local SQLite Database & Audit Cache
backend/*.db
backend/*.db-journal
*.sqlite3

# Dynamic Uploads and Annotated Output Caches (Keep empty folder structures)
backend/uploads/*
!backend/uploads/.gitkeep
backend/annotated/*
!backend/annotated/.gitkeep

# Environment Variables & Secret Credentials
.env
.env.*
!.env.example
*.pem
*.key
*.cert
credentials.json

# Operating System & IDE Cache
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~
*.log
